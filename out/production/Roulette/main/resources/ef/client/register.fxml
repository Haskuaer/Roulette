<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="400.0" prefWidth="400.0" styleClass="stage" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ef.client.controllers.RegisterController">
    <children>
        <Pane prefHeight="25.0" prefWidth="400.0" styleClass="windowBar" stylesheets="@style.css">
            <children>
                <Button fx:id="exitBtn" layoutX="350.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="50.0" text="x" textAlignment="CENTER">
                    <styleClass>
                        <String fx:value="exitBtn" />
                        <String fx:value="exitBtn" />
                    </styleClass></Button>
                <Button fx:id="minimizeBtn" layoutX="300.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="50.0" styleClass="minimizeBtn" text="_" textAlignment="CENTER" />
            </children>
        </Pane>
        <TextField fx:id="username" layoutX="125.0" layoutY="150.0" prefHeight="25.0" prefWidth="150.0" />
        <Label layoutX="125.0" layoutY="190.0" prefHeight="25.0" prefWidth="150.0" text="Password:">
            <font>
                <Font size="15.0" />
            </font>
        </Label>
        <Label layoutX="125.0" layoutY="120.0" prefHeight="25.0" prefWidth="150.0" text="Username:">
            <font>
                <Font size="15.0" />
            </font>
        </Label>
        <PasswordField fx:id="password" layoutX="125.0" layoutY="220.0" prefHeight="25.0" prefWidth="150.0" />
        <Label layoutX="125.0" layoutY="260.0" prefHeight="25.0" prefWidth="150.0" text="Confirm password:">
            <font>
                <Font size="15.0" />
            </font>
        </Label>
        <PasswordField fx:id="confirmedPassword" layoutX="125.0" layoutY="290.0" prefHeight="25.0" prefWidth="150.0" />
        <Label alignment="CENTER" contentDisplay="CENTER" layoutY="60.0" prefHeight="40.0" prefWidth="400.0" styleClass="titleLabel" text="Registration" textAlignment="CENTER">
            <font>
                <Font size="25.0" />
            </font>
        </Label>
        <Button fx:id="goLoginBtn" layoutX="125.0" layoutY="330.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="70.0" styleClass="funBtn" text="Back" />
        <Button fx:id="registerBtn" layoutX="205.0" layoutY="330.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="70.0" styleClass="funBtn" text="Register" />
    </children>
</AnchorPane>